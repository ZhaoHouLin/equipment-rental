# JWT 簽章密鑰，必填，隨機長字串。缺少時 server 啟動失敗。
NUXT_JWT_SECRET=change-me-to-a-long-random-string
# 管理員登入有效分鐘數，預設 30
NUXT_SESSION_MINUTES=30
# SQLite 檔案位置，預設 data/rental.sqlite（容器內請掛 volume）
NUXT_DB_PATH=data/rental.sqlite

# 管理員登入方式：local（帳密在下方）或 ldap（公司 AD）
NUXT_AUTH_MODE=local
NUXT_ADMIN_USER=admin
# 產生：node -e "console.log(require('bcryptjs').hashSync('你的密碼', 10))"
NUXT_ADMIN_PASSWORD_HASH=
# ldap 模式必填
NUXT_LDAP_URL=ldap://ldap.example.com
NUXT_LDAP_DOMAIN=example.com

# SMTP 轉信主機；留空不寄信
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=25
NUXT_MAIL_FROM=rental@example.com

# 設為 1 時，資料庫是空的就塞示範資料
NUXT_SEED_DEMO=
