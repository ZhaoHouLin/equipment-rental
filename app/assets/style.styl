flex(juc=center,ali=center,direction=row)
	display flex
	justify-content juc
	align-items ali
	flex-direction direction
	
pos(l=50%,t=l)
	position absolute
	left l
	top t

size(w=100%,h=w)
	width w
	height h

random(min,max)
	return floor(math(0, 'random')*(max - min + 1) + min)


fontStyle(fz=1.6rem)
	font-size fz
	line-height (fz * 2)
	text-indent (fz * 2)
	letter-spacing 4px

outlineSpace = 1.4rem

color_primary = rgb(0, 0, 0)
// color_secondary = rgb(76, 86, 106)
color_secondary = rgb(54, 79, 199)
color_tertiary = rgb(255, 255, 255)

*
  box-sizing border-box
	margin 0
	padding 0  
	font-family '微軟正黑體'
	

html,body
	-webkit-overflow-scrolling touch
	overflow-scrolling touch
	background-color color_secondary
	size()
	
body
	font-size 16px


	



